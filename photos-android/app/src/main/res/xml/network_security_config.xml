<?xml version="1.0" encoding="utf-8"?>
<!-- Allows cleartext HTTP to localhost/LAN during development.
     In production (Railway/Render), HTTPS is used — this file is not needed. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>        <!-- Emulator localhost -->
        <domain includeSubdomains="false">192.168.137.1</domain>  <!-- Your PC WiFi IP -->
        <domain includeSubdomains="false">192.168.56.1</domain>
    </domain-config>
</network-security-config>
