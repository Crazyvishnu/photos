<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:theme="@style/ThemeOverlay.PhotosApp.Viewer" android:background="@color/viewer_surface">
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/view_pager" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <FrameLayout android:id="@+id/top_chrome" android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="top" android:background="@color/viewer_surface">
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="match_parent"
            app:navigationIcon="@drawable/ic_view_back" app:titleTextColor="@color/viewer_text" app:subtitleTextColor="@color/viewer_ink"/>
        <LinearLayout android:id="@+id/date_header" android:layout_width="144dp" android:layout_height="match_parent" android:layout_gravity="center"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="@string/viewer_date_action">
            <TextView android:id="@+id/viewer_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp"
                android:textColor="@color/viewer_text" android:fontFamily="sans-serif-medium" android:maxLines="1" android:drawableEnd="@drawable/ic_view_chevron" android:drawablePadding="2dp"/>
            <TextView android:id="@+id/viewer_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/viewer_ink" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/bottom_chrome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="vertical" android:background="@color/viewer_surface">
        <LinearLayout android:id="@+id/video_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:id="@+id/video_actions" android:layout_width="match_parent" android:layout_height="48dp" android:paddingHorizontal="8dp" android:gravity="center" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/play_pause" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:src="@drawable/ic_view_play" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/viewer_play"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/save_frame" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/viewer_capture" android:textSize="13sp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:textColor="@color/viewer_ink" app:iconTint="@color/viewer_ink" app:icon="@android:drawable/ic_menu_camera"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/mute_video" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_view_volume" app:iconTint="@color/viewer_ink" app:iconPadding="0dp" android:contentDescription="@string/viewer_mute" android:minWidth="0dp" android:padding="12dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/fullscreen_media" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_view_fullscreen" app:iconTint="@color/viewer_ink" app:iconPadding="0dp" android:contentDescription="@string/viewer_fullscreen" android:minWidth="0dp" android:padding="12dp"/>
        </LinearLayout>
        <TextView android:id="@+id/playback_time" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center"
            android:textColor="@color/viewer_ink" android:textSize="13sp" android:importantForAccessibility="no"/>
        <SeekBar android:id="@+id/video_seek" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="16dp"
            android:max="10000" android:progressTint="@color/viewer_ink" android:progressBackgroundTint="#DADCE0" android:secondaryProgressTint="#DADCE0"
            android:thumbTint="@color/viewer_ink" android:splitTrack="false" android:contentDescription="@string/viewer_seek"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/status_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp"
            android:paddingHorizontal="12dp" android:gravity="center_vertical">
            <TextView android:id="@+id/photo_backup_status" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:gravity="center_vertical" android:textColor="@color/viewer_ink" android:textSize="12sp" android:drawablePadding="8dp" android:clickable="true" android:focusable="true"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/show_details" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/media_details" android:textColor="@color/viewer_ink"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:paddingHorizontal="8dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/share_media" style="@style/ViewerAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:text="@string/viewer_share" app:icon="@drawable/ic_view_share"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/edit_media" style="@style/ViewerAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:text="@string/viewer_edit" app:icon="@drawable/ic_view_edit"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/add_to_album" style="@style/ViewerAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:text="@string/viewer_add_to" app:icon="@drawable/ic_view_add"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/bin_media" style="@style/ViewerAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="72dp" android:text="@string/viewer_bin" app:icon="@drawable/ic_view_bin"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
