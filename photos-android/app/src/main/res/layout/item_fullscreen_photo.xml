<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/viewer_surface">
    <ImageView android:id="@+id/image_view" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter"/>
    <androidx.media3.ui.PlayerView android:id="@+id/player_view" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/viewer_surface" android:visibility="gone" app:use_controller="false" app:resize_mode="fit" app:show_buffering="when_playing" app:surface_type="texture_view"/>
    <View android:id="@+id/immersive_touch_target" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="true" android:focusable="true" android:contentDescription="Show photo controls"/>
    <ImageView android:id="@+id/video_indicator" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center"
        android:src="@drawable/ic_play_circle" android:visibility="gone" android:background="@drawable/bg_circle_translucent" android:clickable="true" android:focusable="true"/>
    <ProgressBar android:id="@+id/media_loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:visibility="gone"/>
    <TextView android:id="@+id/media_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:layout_gravity="bottom" android:padding="16dp" android:gravity="center" android:background="#CC202124" android:textColor="@android:color/white"
        android:textSize="14sp" android:visibility="gone" android:clickable="true" android:focusable="true"/>
</FrameLayout>
